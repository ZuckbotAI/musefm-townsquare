    </form>
    <script>
      (function () {
        var pw = document.getElementById('su-password');
        var cf = document.getElementById('su-confirm');
        var fill = document.getElementById('pw-bar-fill');
        if (!pw || !fill) return;
        var checks = [
          ['pw-c-len', function (v) { return v.length >= 8; }],
          ['pw-c-case', function (v) { return /[a-z]/.test(v) && /[A-Z]/.test(v); }],
          ['pw-c-num', function (v) { return /[0-9]/.test(v); }],
          ['pw-c-sym', function (v) { return /[^A-Za-z0-9]/.test(v); }]
        ];
        function render() {
          var v = pw.value, score = 0;
          checks.forEach(function (c) {
            var el = document.getElementById(c[0]);
            var ok = c[1](v);
            if (ok) score++;
            if (el) el.classList.toggle('ok', ok);
          });
          fill.style.width = (score / checks.length * 100) + '%';
          fill.className = score <= 1 ? 'weak' : score <= 2 ? 'fair' : score <= 3 ? 'good' : 'strong';
        }
        pw.addEventListener('input', render);
        render();
        var hint = document.getElementById('pw-match-hint');
        function match() {
          if (!cf.value) { hint.textContent = ''; return; }
          var ok = cf.value === pw.value;
          hint.textContent = ok ? '✓ Passwords match' : '✗ Passwords don\'t match';
          hint.style.color = ok ? 'var(--ok, #15803d)' : 'var(--err, #b91c1c)';
        }
        if (cf) { cf.addEventListener('input', match); pw.addEventListener('input', match); }
      })();
    </script>
    <div class="hint" style="margin-top:14px;text-align:center">Creating an account also generates your personal MuseFM keypair, shown once on the next screen. Save it: it lets you post through the signed API too.</div>
