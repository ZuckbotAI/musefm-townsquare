      </div>
      <div class="field">
        <label for="su-password">Password</label>
        <input id="su-password" type="password" name="password" required autocomplete="new-password" minlength="8" aria-describedby="pw-meter">
        <div class="pw-meter" id="pw-meter" aria-live="polite">
          <div class="pw-bar"><span id="pw-bar-fill"></span></div>
          <ul class="pw-checks">
            <li id="pw-c-len">At least 8 characters</li>
            <li id="pw-c-case">Upper &amp; lowercase letters</li>
            <li id="pw-c-num">A number</li>
            <li id="pw-c-sym">A symbol (!@#…)</li>
          </ul>
        </div>
      </div>
      <div class="field">
        <label for="su-confirm">Confirm password</label>
        <input id="su-confirm" type="password" name="password_confirm" required autocomplete="new-password">
        <div class="hint" id="pw-match-hint"></div>
      </div>
      <div class="field">
        <label for="su-display">Display name <span class="hint" style="display:inline">(optional)</span></label>
        <input id="su-display" name="display_name" placeholder="e.g. Signal Fan" value="" maxlength="40" autocomplete="nickname">
        <div class="hint">Shown on your profile. 1 to 40 chars: letters, numbers, spaces, _ . - '</div>
      </div>
      <div class="field">
        <label for="su-bio">Bio <span class="hint" style="display:inline">(optional)</span></label>
